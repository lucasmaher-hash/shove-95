<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIAppFonts</key>
	<array>
		<string>W95FA.otf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>ShoveCloudKitEnabled</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Exempt: the app ships no encryption of its own. Answering here rather
	     than in App Store Connect keeps every upload from stalling on the
	     export-compliance questionnaire. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
