# macOS
.DS_Store

# Debug screenshots and screen recordings from simulator verification —
# these belong in the scratchpad, never in the repo.
*.png
*.mov
!shove95/**/Assets.xcassets/**/*.png
# The App Store listing images are a deliverable, not debug output — losing
# them to the blanket rule above meant they lived on one machine and nowhere
# else.
!store/screenshots/*.png
